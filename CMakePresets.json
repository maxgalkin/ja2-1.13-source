{
  "version": 3,
  "configurePresets": [
    {
      "name": "ja2mod-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "Languages": "ENGLISH",
        "Applications": "JA2",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "."
      },
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "ja2mod-release",
      "inherits": "ja2mod-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "ja2mod-relwithdebinfo",
      "inherits": "ja2mod-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "ja2mod-debug",
      "inherits": "ja2mod-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ]
}
